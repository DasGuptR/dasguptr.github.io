# Chunk 18
aggrfunc_sub <- function(x, idx){
# put back in the missing group proportion, as 1-sum(others):
# note that x is now of length (I*K)-1.
ws = append(x[1:12], 1-sum(x[1:12]), after = idx-1)
rs = x[13:25]
sum(ws*rs)
}
